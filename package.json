{
	"name": "@ventrata/octo-types",
	"version": "0.1.2",
	"private": false,
	"license": "ISC",
	"types": "dist/index.d.ts",
	"repository": {
		"url": "https://github.com/ventrata/octo-types"
	},
	"main": "dist/index.js",
	"module": "dist/esm/index.js",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/index.js"
		},
		"./models/*": {
			"types": "./dist/models/*.d.ts",
			"import": "./dist/esm/models/*.js",
			"require": "./dist/models/*.js"
		},
		"./schemas/*": {
			"types": "./dist/schemas/*.d.ts",
			"import": "./dist/esm/schemas/*.js",
			"require": "./dist/schemas/*.js"
		},
		"./schemas-mini": {
			"types": "./dist/schemas-mini/index.d.ts",
			"import": "./dist/esm/schemas-mini/index.js",
			"require": "./dist/schemas-mini/index.js"
		},
		"./schemas-mini/*": {
			"types": "./dist/schemas-mini/*.d.ts",
			"import": "./dist/esm/schemas-mini/*.js",
			"require": "./dist/schemas-mini/*.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"get:openapi:yaml": "node scripts/get-openapi-yaml.mts",
		"generate:models": "openapi --input src/openapi.yaml --output src/ --exportCore false --exportServices false --client none",
		"generate:schemas": "node scripts/generate-schemas.mts",
		"generate:schemas-mini": "node scripts/generate-zod-mini-schemas.mts && biome format --write src/schemas-mini",
		"clean": "rm -rf dist",
		"generate": "npm run generate:models && npm run generate:schemas && npm run generate:schemas-mini && npm run fix",
		"generate:update": "npm run get:openapi:yaml && npm run generate",
		"build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/prepare-esm.mts",
		"build:dry": "tsc --noEmit && tsc -p tsconfig.scripts.json",
		"check": "npm run build:dry && npm run format && npm run lint",
		"test": "npm run test:unit && npm run test:package",
		"test:unit": "node --test scripts/generate-zod-mini-schemas.test.mts scripts/get-openapi-yaml.test.mts scripts/prepare-esm.test.mts scripts/schema-generation/transforms.test.mts",
		"test:prepare-esm": "node --test scripts/prepare-esm.test.mts",
		"test:schemas-mini": "node --test scripts/generate-zod-mini-schemas.test.mts",
		"test:package": "npm run build && node --test scripts/package.test.mts",
		"fix": "biome check --write .",
		"format": "biome format",
		"format:fix": "biome format --write .",
		"lint": "biome lint",
		"lint:fix": "biome lint --write .",
		"audit": "npm audit",
		"prepare": "npm run build"
	},
	"peerDependencies": {
		"zod": "^4.6.5"
	},
	"overrides": {
		"js-yaml": "4.3.2",
		"lodash": "4.18.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^24.19.1",
		"esbuild": "0.28.2",
		"openapi-typescript-codegen": "^0.31.0",
		"ts-to-zod": "^5.1.0",
		"typescript": "^5.9.3",
		"zod": "^4.6.5"
	}
}
