{
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "./src",
		"target": "ES2021",
		"module": "CommonJS",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/**.ts"],
	"exclude": ["node_modules"]
}
